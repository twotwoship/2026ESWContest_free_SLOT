000000da <Angle_ToPulse>:
// 각도(0~180) -> 펄스폭(us) 변환
// PULSE_MIN_US(0도) ~ PULSE_MAX_US(180도) 선형 매핑
uint16_t Angle_ToPulse(uint8_t angle_deg)
{
    uint32_t range = (uint32_t)(PULSE_MAX_US - PULSE_MIN_US);
    return (uint16_t)(PULSE_MIN_US + (range * angle_deg) / 180u);
