#!/bin/sh
set -eu

xset s off
xset -dpms
xset s noblank

# Audio devices can appear after the X session. Keep this best-effort work in
# the background so a missing/default sink can never prevent the LCD kiosk
# from starting.
configure_audio() {
    if [ -x /usr/bin/wpctl ]; then
        /usr/bin/wpctl settings \
            device.routes.default-sink-volume 1.0 >/dev/null 2>&1 || :
        /usr/bin/wpctl settings --save \
            device.routes.default-sink-volume >/dev/null 2>&1 || :

        audio_attempt=0
        while [ "$audio_attempt" -lt 20 ]; do
            if /usr/bin/wpctl set-volume \
                    @DEFAULT_AUDIO_SINK@ 1.0 >/dev/null 2>&1; then
                break
            fi
            audio_attempt=$((audio_attempt + 1))
            sleep 1
        done
    fi

    if [ -x /usr/bin/amixer ]; then
        /usr/bin/amixer -q -c Headphones \
            sset PCM 100% unmute >/dev/null 2>&1 || :
    fi
}

configure_audio &

/usr/bin/openbox --config-file /etc/xdg/openbox/rc.xml &

until /usr/bin/curl --silent --fail --max-time 2 \
    http://127.0.0.1:5000/api/display-status >/dev/null; do
    sleep 1
done

exec /usr/bin/chromium \
    --kiosk \
    --app=http://127.0.0.1:5000/display \
    --user-data-dir="$HOME/.config/slotguard-chromium" \
    --lang=ko-KR \
    --password-store=basic \
    --disable-sync \
    --disable-extensions \
    --disable-component-update \
    --disable-translate \
    --no-first-run \
    --disable-pinch \
    --disable-features=Translate,TranslateUI \
    --disable-session-crashed-bubble \
    --noerrdialogs \
    --overscroll-history-navigation=0
